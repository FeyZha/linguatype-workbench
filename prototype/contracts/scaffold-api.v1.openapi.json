{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "LinguaType Expression Scaffold API",
    "version": "1.0.0",
    "description": "Frozen public contract for generating expression scaffolds for one mixed Chinese-English target sentence."
  },
  "paths": {
    "/api/scaffold": {
      "post": {
        "operationId": "generateExpressionScaffold",
        "summary": "Generate expression help for one target sentence",
        "description": "Reads the IELTS task, full essay, and one target sentence. The server owns Chinese-segment extraction and routes each segment to either one direct expression or a two-to-three-part scaffold set.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScaffoldRequest"
              },
              "examples": {
                "direct": {
                  "summary": "One short Chinese segment",
                  "value": {
                    "taskPrompt": "Some people think public transport should be free. To what extent do you agree or disagree?",
                    "fullEssay": "Better public transport can 缓解交通拥堵. This would benefit commuters and cities alike.",
                    "targetSentence": "Better public transport can 缓解交通拥堵."
                  }
                },
                "complex": {
                  "summary": "One complex Chinese segment",
                  "value": {
                    "taskPrompt": "Governments should spend more money on public transport than on roads. Discuss both views and give your opinion.",
                    "fullEssay": "Governments should 政府应该投入更多资金来改善公共交通. This can make daily travel more efficient.",
                    "targetSentence": "Governments should 政府应该投入更多资金来改善公共交通."
                  }
                },
                "multiple": {
                  "summary": "A sentence containing both short and complex Chinese segments",
                  "value": {
                    "taskPrompt": "Some people believe businesses need more regulation, while others prefer fewer restrictions. Discuss both views.",
                    "fullEssay": "Many people believe 政府监管 is necessary, while others worry it may 限制企业创新和长期发展. Both concerns deserve consideration.",
                    "targetSentence": "Many people believe 政府监管 is necessary, while others worry it may 限制企业创新和长期发展."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One model call completed and every Chinese segment was returned in its server-selected help mode.",
            "headers": {
              "x-linguatype-api-version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaffoldResponse"
                },
                "examples": {
                  "direct": {
                    "summary": "Direct expression response",
                    "value": {
                      "items": [
                        {
                          "sourceZh": "缓解交通拥堵",
                          "action": "provide_expression",
                          "recommendedExpression": "ease traffic congestion",
                          "scaffolds": []
                        }
                      ],
                      "meta": {
                        "requestId": "c4a1f920-7d1a-4fd5-883c-577ad06d1264",
                        "callCount": 1,
                        "latencyMs": 1080,
                        "model": "deepseek-chat",
                        "promptVersion": "expression-scaffold-v7-expression-memory-v1"
                      },
                      "memoryMatchIds": []
                    }
                  },
                  "complex": {
                    "summary": "Complex scaffold response",
                    "value": {
                      "items": [
                        {
                          "sourceZh": "政府应该投入更多资金来改善公共交通",
                          "action": "offer_scaffolds",
                          "recommendedExpression": null,
                          "scaffolds": [
                            {
                              "scaffoldId": "s1",
                              "focusZh": "投入更多资金",
                              "recommendedExpression": "invest more money in ..."
                            },
                            {
                              "scaffoldId": "s2",
                              "focusZh": "改善公共交通",
                              "recommendedExpression": "improve public transport"
                            }
                          ]
                        }
                      ],
                      "meta": {
                        "requestId": "5b4952b7-e895-4092-806e-f11460e5f767",
                        "callCount": 1,
                        "latencyMs": 1432,
                        "model": "deepseek-chat",
                        "promptVersion": "expression-scaffold-v7-expression-memory-v1"
                      },
                      "memoryMatchIds": []
                    }
                  },
                  "multiple": {
                    "summary": "Mixed direct and scaffold response",
                    "value": {
                      "items": [
                        {
                          "sourceZh": "政府监管",
                          "action": "provide_expression",
                          "recommendedExpression": "government regulation",
                          "scaffolds": []
                        },
                        {
                          "sourceZh": "限制企业创新和长期发展",
                          "action": "offer_scaffolds",
                          "recommendedExpression": null,
                          "scaffolds": [
                            {
                              "scaffoldId": "s1",
                              "focusZh": "限制企业创新",
                              "recommendedExpression": "constrain business innovation"
                            },
                            {
                              "scaffoldId": "s2",
                              "focusZh": "限制长期发展",
                              "recommendedExpression": "hold back long-term development"
                            }
                          ]
                        }
                      ],
                      "meta": {
                        "requestId": "a5e1bf8c-cb04-4f1c-b23d-ea63abeb27c5",
                        "callCount": 1,
                        "latencyMs": 1265,
                        "model": "deepseek-chat",
                        "promptVersion": "expression-scaffold-v7-expression-memory-v1"
                      },
                      "memoryMatchIds": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request body violates the frozen input rules.",
            "headers": {
              "x-linguatype-api-version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidInputError"
                },
                "example": {
                  "code": "INVALID_INPUT",
                  "error": "请确认题目、全文和目标句仍然完整。",
                  "requestId": "60e15f6c-80fb-470e-a3a5-74ca35a0ad37"
                }
              }
            }
          },
          "502": {
            "description": "The upstream model request or scaffold validation failed.",
            "headers": {
              "x-linguatype-api-version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaffoldGenerationFailedError"
                },
                "example": {
                  "code": "SCAFFOLD_GENERATION_FAILED",
                  "error": "本句暂时无法处理，原文没有被修改。",
                  "requestId": "9c719438-eaec-4da7-835e-af1e95fe4132"
                }
              }
            }
          },
          "503": {
            "description": "The server does not have a usable model configuration.",
            "headers": {
              "x-linguatype-api-version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelNotConfiguredError"
                },
                "example": {
                  "code": "MODEL_NOT_CONFIGURED",
                  "error": "内部模型尚未配置，原文没有被修改。",
                  "requestId": "a73190d0-afef-453a-8b2a-9c764865d53e"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "ApiVersion": {
        "description": "Frozen LinguaType scaffold API contract version.",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1.0.0",
          "examples": [
            "1.0.0"
          ]
        }
      }
    },
    "schemas": {
      "ScaffoldRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskPrompt",
          "fullEssay",
          "targetSentence"
        ],
        "properties": {
          "taskPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "IELTS writing task. Leading and trailing whitespace is removed before validation."
          },
          "fullEssay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "Current full essay. After trimming, it must contain the trimmed targetSentence verbatim."
          },
          "targetSentence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "[\\u3400-\\u9fff]",
            "description": "Exactly one current sentence to process. It must occur in fullEssay and contain at least one CJK Unified Ideograph."
          },
          "memoryCandidates": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ExpressionMemoryCandidate"
            },
            "description": "Locally retrieved active memories. Counts and status are never sent."
          }
        }
      },
      "ScaffoldResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "memoryMatchIds",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ScaffoldResponseItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "memoryMatchIds": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "IDs selected only from request memoryCandidates; empty is valid."
          }
        }
      },
      "ScaffoldResponseItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DirectItem"
          },
          {
            "$ref": "#/components/schemas/ScaffoldItem"
          }
        ],
        "discriminator": {
          "propertyName": "action",
          "mapping": {
            "provide_expression": "#/components/schemas/DirectItem",
            "offer_scaffolds": "#/components/schemas/ScaffoldItem"
          }
        }
      },
      "DirectItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceZh",
          "action",
          "recommendedExpression",
          "scaffolds"
        ],
        "properties": {
          "sourceZh": {
            "$ref": "#/components/schemas/SourceZh"
          },
          "action": {
            "type": "string",
            "const": "provide_expression"
          },
          "recommendedExpression": {
            "type": "string",
            "minLength": 1
          },
          "scaffolds": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "ScaffoldItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceZh",
          "action",
          "recommendedExpression",
          "scaffolds"
        ],
        "properties": {
          "sourceZh": {
            "$ref": "#/components/schemas/SourceZh"
          },
          "action": {
            "type": "string",
            "const": "offer_scaffolds"
          },
          "recommendedExpression": {
            "type": "null"
          },
          "scaffolds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Scaffold"
            },
            "description": "Two or three scaffolds in source order. scaffoldId values are contiguous from s1."
          }
        }
      },
      "SourceZh": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[\\u3400-\\u9fff]+(?:[，、；：！？（）“”‘’·—][\\u3400-\\u9fff]+)*$",
        "description": "A top-level Chinese segment extracted by the server, in source order. Ten or fewer Chinese characters route to provide_expression; longer segments route to offer_scaffolds."
      },
      "Scaffold": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scaffoldId",
          "focusZh",
          "recommendedExpression"
        ],
        "properties": {
          "scaffoldId": {
            "type": "string",
            "pattern": "^s[1-3]$"
          },
          "focusZh": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*[\\u3400-\\u9fff])(?!.*[A-Za-z]).+$",
            "description": "A traceable Chinese semantic focus that is strictly shorter than its parent sourceZh."
          },
          "recommendedExpression": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "callCount",
          "latencyMs",
          "model",
          "promptVersion"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "callCount": {
            "type": "integer",
            "const": 1
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "promptVersion": {
            "type": "string",
            "const": "expression-scaffold-v7-expression-memory-v1"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "error",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "MODEL_NOT_CONFIGURED",
              "SCAFFOLD_GENERATION_FAILED"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "InvalidInputError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "properties": {
              "code": {
                "const": "INVALID_INPUT"
              }
            }
          }
        ]
      },
      "ModelNotConfiguredError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "properties": {
              "code": {
                "const": "MODEL_NOT_CONFIGURED"
              }
            }
          }
        ]
      },
      "ScaffoldGenerationFailedError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "properties": {
              "code": {
                "const": "SCAFFOLD_GENERATION_FAILED"
              }
            }
          }
        ]
      },
      "ExpressionMemoryCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chinese",
          "english"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "chinese": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "english": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        }
      }
    }
  }
}
